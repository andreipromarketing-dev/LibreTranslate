                            self.error = e.message;
                            self.loadingTranslation = false;
                        }
                    };

                    request.onerror = function() {
                        self.error = {{ _e("Cannot load %(url)s", url=url_prefix + "/translate") }};
                        self.loadingTranslation = false;
                    };

                    request.send(data);
                }, self.frontendTimeout);
