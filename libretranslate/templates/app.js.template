// JSON Import для аббревиатур
onDragOver: function(e, type) { e.preventDefault(); this.jsonDragOver[type] = true; },
onDragLeave: function(e, type) { e.preventDefault(); this.jsonDragOver[type] = false; },
onJsonDrop: function(e, type) { 
    e.preventDefault(); 
    this.jsonDragOver[type] = false; 
    let file = e.dataTransfer.files[0];
    if (file && file.type === 'application/json') this.processJsonFile(file, type);
},

onJsonFileSelect: function(e, type) {
    let file = e.target.files[0];
    if (file) this.processJsonFile(file, type);
},

processJsonFile: function(file, type) {
    let reader = new FileReader();
    reader.onload = (e) => {
        try {
            let data = JSON.parse(e.target.result);
            this.importJsonData(data, type);
        } catch (err) {
            handleNotification("Error", "{{ _h('Invalid JSON file') }}");
        }
    };
    reader.readAsText(file);
},

onJsonPaste: function(e, type) {
    let text = e.clipboardData.getData('text');
    if (text.trim().startsWith('{')) this.jsonPasteText[type] = text;
},

importFromPaste: function(type) {
    try {
        let data = JSON.parse(this.jsonPasteText[type]);
        this.importJsonData(data, type);
        this.cancelJsonImport(type);
    } catch (e) { handleNotification("Error", "{{ _h('Invalid JSON format') }}"); }
},

importJsonData: function(data, type) {
    let url = type === 'abbr' ? "/abbreviations/import/json" : "/glossary/import/json";
    fetch(BaseUrl + url, {
        method: "POST",
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries: data.entries, skip_existing: true })
    }).then(r => r.json()).then(res => {
        if (type === 'abbr') this.loadAbbreviations(); else this.loadGlossary();
        handleNotification("Success", "{{ _h('Imported') }}: " + res.added + ", " + "{{ _h('skipped') }}: " + res.skipped);
    });
},

cancelJsonImport: function(type) {
    this.jsonImportMode[type] = false;
    this.jsonPasteText[type] = '';
    this.$refs[type + 'JsonFile'].value = '';
