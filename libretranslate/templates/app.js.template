                req.onload = function() {
                    if (req.readyState === 4 && req.status === 200) {
                        let job = JSON.parse(req.response);
                        self.fileJobPaused = !(job.status === "running");
                    }
                };
                req.send();
            },
            stopFileJob: function() {
                let self = this;
                let req = new XMLHttpRequest();
                req.open("POST", BaseUrl + "/translate_job/" + self.fileJobId + "/stop", true);
                req.onload = function() {
                    if (req.readyState === 4 && req.status === 200) {
                        if (self.filePollTimer) {
                            clearInterval(self.filePollTimer);
                            self.filePollTimer = false;
                        }
                        self.loadingFileTranslation = false;
                        self.fileJobPaused = false;
                        self.translatedFileUrl = false;
                        handleNotification("Translation Cancelled", "Translation of " + self.inputFile.name + " was cancelled.");
                    }
                };
                req.send();
            },
            chooseSaveDirectory: function() {
                let self = this;
                if (!window.showDirectoryPicker) {
                    self.saveDirectoryError = {{ _e("Folder selection is supported only in Chromium-based browsers (Chrome, Edge, Opera, Comet).") }};
                    return;
                }
                window.showDirectoryPicker({ id: "libretranslate-save-dir", mode: "readwrite" }).then(function(handle) {
                    self.saveDirHandle = handle;
                    self.saveDirectoryName = handle.name;
                    self.saveDirectoryError = "";
                    return self.storeSaveDirectory(handle);
                }).catch(function(err) {
                    if (err && err.name === "AbortError") return;
                    self.saveDirectoryError = err && err.message ? err.message : String(err);
                });
            },
            storeSaveDirectory: function(handle) {
                return new Promise(function(resolve, reject) {
                    const req = indexedDB.open("libretranslate", 1);
                    req.onupgradeneeded = function() {
                        req.result.createObjectStore("settings");
                    };
                    req.onsuccess = function() {
                        const tx = req.result.transaction("settings", "readwrite");
                        tx.objectStore("settings").put(handle, "saveDirHandle");
                        tx.oncomplete = function() { resolve(); };
                        tx.onerror = function() { reject(tx.error); };
                    };
                    req.onerror = function() { reject(req.error); };
                });
            },
            loadSaveDirectory: function() {
                return new Promise(function(resolve) {
                    if (!window.indexedDB) { resolve(null); return; }
                    const req = indexedDB.open("libretranslate", 1);
                    req.onupgradeneeded = function() {
                        req.result.createObjectStore("settings");
                    };
                    req.onsuccess = function() {
                        const tx = req.result.transaction("settings", "readonly");
                        const getReq = tx.objectStore("settings").get("saveDirHandle");
                        getReq.onsuccess = function() { resolve(getReq.result || null); };
                        getReq.onerror = function() { resolve(null); };
                        tx.onerror = function() { resolve(null); };
                    };
                    req.onerror = function() { resolve(null); };
                });
            },
            saveTranslatedFile: function(url) {
                let self = this;
                
                // Guard against multiple calls from polling
                if (self._saveInProgress) return;
                self._saveInProgress = true;
                
                self.lastTranslatedFileUrl = url;
                const fileName = url.split("/").pop() || "translated.pdf";
                
                // 1. AUTO DOWNLOAD to Downloads folder (always works, non-blocking)
                let link = document.createElement("a");
                link.href = url;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                // 2. NATIVE "Save As..." dialog (Chrome/Edge) - runs in parallel, non-blocking
                if (window.showSaveFilePicker) {
                    fetch(url)
                        .then(function(r) { return r.blob(); })
                        .then(function(blob) {
                            return window.showSaveFilePicker({
                                suggestedName: fileName,
                                types: [{ description: 'PDF Document', accept: { 'application/pdf': ['.pdf'] } }]
                            }).then(function(handle) {
                                return handle.createWritable().then(function(writable) {
                                    return writable.write(blob).then(function() {
                                        writable.close();
                                        handleNotification("Saved", {{ _e("Saved to") }} + " " + handle.name);
                                    });
                                });
                            }).catch(function(err) {
                                if (err.name !== 'AbortError') {
                                    console.warn("Save dialog failed:", err);
                                }
                            });
                        })
                        .catch(function() {});
                }
                
                // 3. SAVE TO USER-SELECTED FOLDER (if any) - silent background save
                if (self.saveDirHandle) {
                    fetch(url)
                        .then(function(r) { return r.blob(); })
                        .then(function(blob) {
                            return self.saveDirHandle.getFileHandle(fileName, { create: true })
                                .then(function(fileHandle) { return fileHandle.createWritable(); })
                                .then(function(writable) {
                                    return writable.write(blob).then(function() { return writable.close(); });
                                });
                        })
                        .then(function() {
                            self.saveDirectoryError = "";
                            // Silent - no notification to avoid spam
                        })
                        .catch(function() {
                            self.saveDirectoryError = {{ _e("Could not write to the selected folder, the file was downloaded instead.") }};
                        });
                }
                
                // Single notification
                let msg = "Finished translating " + self.inputFile.name + ". " + {{ _e("File downloaded to your default Downloads folder") }};
                if (self.saveDirHandle) {
                    msg += " " + {{ _e("and saved to") }} + " " + self.saveDirHandle.name;
                }
                handleNotification("Translation Complete", msg);
                
                self._saveInProgress = false;
            },
            
            openLastTranslation: function() {
                if (this.lastTranslatedFileUrl) {
                    window.open(this.lastTranslatedFileUrl, '_blank');
                }
            },

            saveTranslationAs: function() {
                let self = this;
                if (!self.translatedFileUrl) return;

                const url = self.translatedFileUrl;
                const fileName = url.split("/").pop() || "translated.pdf";

                // Force download via blob URL - works even if main save failed
                fetch(url)
                    .then(function(r) { return r.blob(); })
                    .then(function(blob) {
                        const blobUrl = URL.createObjectURL(blob);

                        // Try File System Access API first (Chrome/Edge)
                        if (window.showSaveFilePicker) {
                            return window.showSaveFilePicker({
                                suggestedName: fileName,
                                types: [{
                                    description: 'PDF Document',
                                    accept: { 'application/pdf': ['.pdf'] }
                                }]
                            }).then(function(handle) {
                                return handle.createWritable().then(function(writable) {
                                    return writable.write(blob).then(function() {
                                        writable.close();
                                        URL.revokeObjectURL(blobUrl);
                                        handleNotification("Saved", {{ _e("Saved to") }} + " " + handle.name);
                                    });
                                });
                            }).catch(function() {
                                // User cancelled or API failed - fallback to blob download
                                self._forceBlobDownload(blobUrl, fileName);
                            });
                        }

                        // Fallback: force blob download
                        self._forceBlobDownload(blobUrl, fileName);
                    })
                    .catch(function(err) {
                        console.error("Save translation as failed:", err);
                        // Ultimate fallback: direct link click
                        let link = document.createElement("a");
                        link.href = url;
                        link.download = fileName;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        handleNotification("Saved", {{ _e("File downloaded to your default Downloads folder") }});
                    });
            },

            _forceBlobDownload: function(blobUrl, fileName) {
                let link = document.createElement("a");
                link.href = blobUrl;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                // Revoke after a delay to ensure download starts
                setTimeout(function() { URL.revokeObjectURL(blobUrl); }, 10000);
                handleNotification("Saved", {{ _e("File downloaded to your default Downloads folder") }});
            }
        }
    });
});

